# ---------------------------------------------------------------------------
# 校园闲置平台 —— 环境变量示例
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交密钥。
# ---------------------------------------------------------------------------

# 运行环境：development | production
NODE_ENV=development

# 前端：是否使用本地 Mock 数据
# Phase 1 为 true；Phase 3 接入真实 API 后改为 false
VITE_USE_MOCK=true

# 前端：API 基础路径（开发环境由 Vite proxy 转发到本地后端）
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# 以下变量供 Phase 2 后端使用，Phase 1 暂未读取
# ---------------------------------------------------------------------------

# 服务端口
PORT=3000

# PostgreSQL 连接串
DATABASE_URL=postgresql://user:password@host:5432/campus_market?schema=public

# JWT 签名密钥（生产环境必须替换为足够随机的高强度字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 图片对象存储（生产使用 S3 兼容服务，如 Cloudflare R2）
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 跨域白名单（同源部署时留空）
CORS_ORIGIN=
