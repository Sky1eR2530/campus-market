# ---------------------------------------------------------------------------
# 前端环境变量
# 复制为 apps/web/.env 后按需修改。
# ---------------------------------------------------------------------------

# 是否使用本地 Mock 数据。
# Phase 1 / 2 期间为 true；Phase 3 接入真实 API 后改为 false。
VITE_USE_MOCK=true

# API 基础路径。生产环境与前端同源，保持 /api 即可。
VITE_API_BASE_URL=/api

# 开发环境 Vite 代理的目标地址（后端 API 服务）
VITE_DEV_API_TARGET=http://localhost:3000
