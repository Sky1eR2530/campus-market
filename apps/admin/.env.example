# ---------------------------------------------------------------------------
# 管理后台环境变量
# 复制为 apps/admin/.env 后按需修改。
# ---------------------------------------------------------------------------

# API 基础路径。开发环境由 Vite 代理到本地后端，生产环境与前端同源。
VITE_API_BASE_URL=/api

# 开发环境 Vite 代理的目标地址
VITE_DEV_API_TARGET=http://localhost:3000

# 部署子路径。生产环境由后端在 /admin/ 下托管，因此为 /admin/
VITE_PUBLIC_BASE=/
