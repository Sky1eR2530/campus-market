// ===========================================================================
// 校园闲置平台 —— 数据库模型
// 设计说明见 docs/phase-0-plan.md 第 6 节。
// ===========================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 说明：Prisma 7 起连接串不再写在 schema 中。
// - 迁移 / 内省命令使用的连接串来自 prisma.config.ts 的 datasource.url
// - 运行时的连接由 PrismaClient 的 driver adapter 提供（见 src/lib/prisma.ts）

// ---------------------------------------------------------------------------
// 枚举
// ---------------------------------------------------------------------------

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  banned
}

/// 商品状态：在售 / 已售 / 下架
enum ItemStatus {
  on_sale
  sold
  off_shelf
}

enum AdminTargetType {
  user
  item
}

// ---------------------------------------------------------------------------
// 用户
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// 登录账号。统一以小写存储以保证大小写不敏感的唯一性，
  /// 写入前由服务层规范化（不使用 citext，避免额外扩展依赖）。
  email        String     @unique @db.VarChar(120)
  passwordHash String     @map("password_hash") @db.VarChar(100)
  nickname     String     @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url") @db.Text
  school       String?    @db.VarChar(50)
  campus       String?    @db.VarChar(50)
  /// 联系方式，仅对已登录用户展示
  contact      String?    @db.VarChar(100)
  bio          String?    @db.VarChar(200)
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)

  items        Item[]
  favorites    Favorite[]
  adminActions AdminAction[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// 商品分类
// ---------------------------------------------------------------------------

/// 分类是数据表而非枚举：新增分类只需在后台添加，不需要改代码或发版。
/// slug 作为对外稳定标识，改名不会破坏已有链接。
model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(20)
  icon      String   @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items Item[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// 商品
// ---------------------------------------------------------------------------

model Item {
  id          String     @id @default(uuid(7)) @db.Uuid
  sellerId    String     @map("seller_id") @db.Uuid
  categoryId  Int        @map("category_id")
  title       String     @db.VarChar(60)
  description String     @db.Text
  /// 价格以「分」为单位的整数存储，避免浮点误差
  priceCents  Int        @map("price_cents")
  status      ItemStatus @default(on_sale)
  /// 从卖家继承，用于后续的同校/同校区筛选
  school      String?    @db.VarChar(50)
  campus      String?    @db.VarChar(50)
  viewCount   Int        @default(0) @map("view_count")
  /// 冗余计数，避免列表页为了显示收藏数而做 N+1 查询
  favoriteCount Int      @default(0) @map("favorite_count")
  /// 列表排序依据。重新上架时刷新，让商品回到列表前面
  publishedAt DateTime   @default(now()) @map("published_at") @db.Timestamptz(3)
  /// 软删除：后台的异常信息处理需要保留可追溯记录
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category  Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ItemImage[]
  favorites Favorite[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@map("items")
}

model ItemImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  /// 访问地址（对象存储 / CDN）
  url        String   @db.Text
  /// 对象存储中的 key，便于删除与迁移；本地磁盘驱动下为相对路径
  storageKey String   @map("storage_key") @db.Text
  /// 0 为封面图
  sortOrder  Int      @default(0) @map("sort_order")
  /// 记录尺寸，前端可预留占位避免图片加载时布局跳动
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("item_images")
}

// ---------------------------------------------------------------------------
// 收藏
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// 数据库层面保证「同一用户对同一商品只会有一条收藏记录」，
  /// 重复收藏由应用层做幂等处理
  @@unique([userId, itemId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// 后台操作日志（Phase 4 启用）
// ---------------------------------------------------------------------------

model AdminAction {
  id         String          @id @default(uuid(7)) @db.Uuid
  adminId    String          @map("admin_id") @db.Uuid
  targetType AdminTargetType @map("target_type")
  targetId   String          @map("target_id") @db.Uuid
  /// ban / unban / take_down / restore / delete
  action     String          @db.VarChar(40)
  reason     String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("admin_actions")
}
