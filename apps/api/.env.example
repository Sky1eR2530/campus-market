# ---------------------------------------------------------------------------
# 后端 API 环境变量
# 复制为 apps/api/.env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交密钥。
# ---------------------------------------------------------------------------

# 运行环境：development | production | test
NODE_ENV=development

# 服务监听端口
PORT=3000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL 连接串
# 本地开发可使用 `pnpm local-db` 启动的实例（见 README）
# 生产环境推荐 Neon / Supabase 等托管服务，并开启 SSL
DATABASE_URL=postgresql://campus:campus@localhost:5433/campus_market?schema=public

# ---------------------------------------------------------------------------
# 以下变量在 Phase 2.2（认证模块）启用
# ---------------------------------------------------------------------------

# JWT 签名密钥：生产环境必须是足够随机的高强度字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 跨域白名单，多个用逗号分隔。同源部署时留空
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# 图片对象存储（Phase 2.4 启用）
# ---------------------------------------------------------------------------

# local：保存在后端磁盘（仅本地开发）
# s3：S3 兼容对象存储（Cloudflare R2 / 阿里云 OSS / AWS S3）
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
