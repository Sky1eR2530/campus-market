# ---------------------------------------------------------------------------
# 后端 API 环境变量
# 复制为 apps/api/.env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交密钥。
# ---------------------------------------------------------------------------

# 运行环境：development | production | test
NODE_ENV=development

# 服务监听端口
PORT=3000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL 连接串
# 本地开发可使用 `pnpm local-db` 启动的实例（见 README）
# 生产环境推荐 Neon / Supabase 等托管服务，并开启 SSL
DATABASE_URL=postgresql://campus:campus@localhost:5433/campus_market?schema=public

# 数据库连接池上限
DATABASE_POOL_SIZE=10

# JWT 签名密钥：至少 32 个字符，生产环境必须是足够随机的高强度字符串
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# 登录凭证有效期。
# 当前使用无状态 JWT，没有刷新令牌，因此有效期就是「多久要重新登录一次」。
# 接入刷新令牌后应缩短到 15m 左右，用刷新令牌维持长期登录。
JWT_EXPIRES_IN=7d

# 跨域白名单，多个用逗号分隔。同源部署时留空
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# 图片存储
# ---------------------------------------------------------------------------

# local：保存在后端磁盘，适合本地开发
# s3：S3 兼容对象存储（尚未实现，计划在部署阶段接入）
STORAGE_DRIVER=local

# 本地驱动的落盘目录（相对 apps/api）
STORAGE_LOCAL_DIR=uploads

# 静态资源对外前缀，必须与落盘目录的托管路径一致
STORAGE_PUBLIC_PATH=/uploads

# 对外可访问的站点地址，例如 https://api.example.com
# 留空则返回相对路径（适合同源部署）
PUBLIC_BASE_URL=

# 单张图片大小上限（字节），默认 5MB
MAX_UPLOAD_BYTES=5242880

# 以下为对象存储预留配置，接入 s3 驱动时使用
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
